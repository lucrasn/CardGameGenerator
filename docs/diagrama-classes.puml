@startuml
title CardGame Framework — baseline atual da main (15/08/2026)

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
hide empty fields

package "br.edu.uepb.map.cardgame.api" as api #EAF2F8 {
    interface Carta <<public>> {
        +id(): UUID
    }

    interface "Baralho<C extends Carta>" as Baralho <<public>> {
        +quantidade(): int
        +estaVazio(): boolean
        +topo(): Optional<C>
        +comprar(): C
        +colocarNoTopo(carta: C): void
        +colocarNaBase(carta: C): void
        +embaralhar(): void
        +cartas(): List<C>
    }

    class "BaralhoPadrao<C>" as BaralhoPadrao <<public>>

    interface "BaralhoFactory<C>" as BaralhoFactory <<public, Factory Method>> {
        +criar(): Baralho<C>
    }

    interface "MaoDeCartas<C>" as MaoDeCartas <<public>> {
        +quantidade(): int
        +adicionar(carta: C): void
        +buscar(id: UUID): Optional<C>
        +remover(id: UUID): C
        +cartas(): List<C>
    }

    class "MaoDeCartasPadrao<C>" as MaoDeCartasPadrao <<public>>

    interface "ContextoDeDistribuicao<C>" as ContextoDeDistribuicao <<public>> {
        +jogadores(): List<Jogador>
        +cartasDisponiveis(): int
        +entregarProximaCarta(jogador: Jogador): void
    }

    interface "EstrategiaDeDistribuicao<C>" as EstrategiaDeDistribuicao <<public, Strategy>> {
        +distribuir(contexto: ContextoDeDistribuicao<C>): void
    }

    class "DistribuicaoAlternada<C>" as DistribuicaoAlternada <<public>>

    interface Jogador <<public>> {
        +id(): UUID
        +nome(): String
        +estrategiaDeDecisao(): EstrategiaDeDecisao
    }

    class JogadorPadrao <<public>>

    interface EstrategiaDeDecisao <<public, Strategy>> {
        +decidir(contexto: ContextoDeDecisao): Jogada
    }

    interface ContextoDeDecisao <<public>>
    interface Jogada <<public>>

    enum EstadoPartida <<public>> {
        CONFIGURADA
        PREPARANDO
        EM_ANDAMENTO
        FINALIZADA
        +podeTransitarPara(destino): boolean
    }

    interface "VisaoDaPartida<C>" as VisaoDaPartida <<public, read-only>> {
        +estado(): EstadoPartida
        +jogadores(): List<Jogador>
        +jogadorAtual(): Jogador
        +maoDe(jogador: Jogador): List<C>
        +quantidadeNoBaralho(): int
        +numeroDoTurno(): long
    }

    interface "ContextoDePartida<C>" as ContextoDePartida <<public>> {
        +comprarDoBaralho(): C
        +adicionarNaMao(jogador: Jogador, carta: C): void
        +removerDaMao(jogador: Jogador, id: UUID): C
        +adicionarAoBaralho(cartas: Collection<C>): void
        +embaralharBaralho(): void
    }

    class "PartidaConfig<C>" as PartidaConfig <<public, immutable>> {
        +builder(): Builder<C>
        +jogadores(): List<Jogador>
        +baralhoFactory(): BaralhoFactory<C>
        +distribuicao(): EstrategiaDeDistribuicao<C>
        +primeiroJogador(): int
    }

    class "PartidaConfig.Builder<C>" as PartidaConfigBuilder <<public>> {
        +jogadores(lista): Builder<C>
        +baralhoFactory(factory): Builder<C>
        +distribuicao(strategy): Builder<C>
        +primeiroJogador(indice): Builder<C>
        +build(): PartidaConfig<C>
    }

    class ResultadoDoTurno <<public, record>> {
        +repetirJogador(): boolean
        +inverterSentido(): boolean
        +jogadoresAPular(): int
    }

    interface MotivoDeEncerramento <<public, extensão>> {
        +ehVitoria(): boolean
        +ehEmpate(): boolean
    }

    enum MotivoPadrao <<public>>
    class DesfechoDePartida <<public, record, immutable>>
    class ResultadoDePartida <<public, record, immutable>>

    interface RegraDeValidacaoStrategy <<public, placeholder vazio>>
    interface RegraDeVitoriaStrategy <<public, placeholder vazio>>
    interface RegraDePontuacaoStrategy <<public, placeholder vazio>>
    interface PartidaListener <<public, placeholder vazio>>

    abstract class PartidaException <<public>>
    class BaralhoVazioException <<public>>
    class JogadaInvalidaException <<public>>
    class EstadoDePartidaInvalidoException <<public>>
}

package "br.edu.uepb.map.cardgame.engine" as engine #FCF3CF {
    abstract class "MotorDePartida<C extends Carta>" as MotorDePartida <<public, Template Method>> {
        +executar(): ResultadoDePartida {final}
        +estado(): EstadoPartida
        #preparar(contexto: ContextoDePartida<C>): void
        #aposDistribuir(contexto: ContextoDePartida<C>): void
        #executarTurno(contexto): ResultadoDoTurno {abstract}
        #avaliarDesfecho(visao): Optional<DesfechoDePartida> {abstract}
        #calcularPontuacao(visao, desfecho): Map<Jogador, Integer>
        #aoEncerrar(visao, resultado): void
    }

    class "PartidaEmExecucao<C>" as PartidaEmExecucao <<package-private>>
    class GerenciadorDeTurnos <<package-private>>
    enum SentidoDeRotacao <<package-private>>
    class CicloDeVidaDaPartida <<package-private>>
    class "ContextoDeDistribuicaoInterno<C>" as ContextoDeDistribuicaoInterno <<package-private>>
}

package "br.edu.uepb.map.cardgame.core" as core #F2F3F4 {
    class ContextoDeDistribuicaoPadrao <<outra trilha>>
    class ContextoDeDecisaoPadrao <<outra trilha>>
    class BaralhoBase <<placeholder legado>>
    class "MaoDeCartas" as MaoDeCartasLegada <<placeholder legado>>
    class Mesa <<placeholder legado>>
}

BaralhoPadrao ..|> Baralho
MaoDeCartasPadrao ..|> MaoDeCartas
DistribuicaoAlternada ..|> EstrategiaDeDistribuicao
JogadorPadrao ..|> Jogador
JogadorPadrao "1" o-- "1" EstrategiaDeDecisao
EstrategiaDeDecisao ..> ContextoDeDecisao
EstrategiaDeDecisao ..> Jogada

ContextoDePartida --|> VisaoDaPartida
MotivoPadrao ..|> MotivoDeEncerramento
DesfechoDePartida --> "0..*" Jogador : vencedores
DesfechoDePartida --> "1" MotivoDeEncerramento
ResultadoDePartida --> "0..*" Jogador : vencedores/placar
ResultadoDePartida --> "1" MotivoDeEncerramento

PartidaConfig "1" o-- "2..*" Jogador
PartidaConfig --> "1" BaralhoFactory
PartidaConfig --> "1" EstrategiaDeDistribuicao
PartidaConfigBuilder ..> PartidaConfig : cria

MotorDePartida --> "1" PartidaConfig
MotorDePartida "1" *-- "1" CicloDeVidaDaPartida
MotorDePartida ..> PartidaEmExecucao : cria por executar()
MotorDePartida ..> ResultadoDoTurno : aplica
MotorDePartida ..> DesfechoDePartida : valida
MotorDePartida ..> ResultadoDePartida : cria

PartidaEmExecucao ..|> ContextoDePartida
PartidaEmExecucao --> "1" Baralho
PartidaEmExecucao "1" *-- "2..*" MaoDeCartas : uma por jogador
PartidaEmExecucao "1" *-- "1" GerenciadorDeTurnos
PartidaEmExecucao "1" *-- "1" CicloDeVidaDaPartida
GerenciadorDeTurnos --> "2..*" Jogador
GerenciadorDeTurnos --> "1" SentidoDeRotacao
ContextoDeDistribuicaoInterno ..|> ContextoDeDistribuicao
ContextoDeDistribuicaoInterno --> "1" PartidaEmExecucao

BaralhoVazioException --|> PartidaException
JogadaInvalidaException --|> PartidaException
EstadoDePartidaInvalidoException --|> PartidaException

note right of MotorDePartida
  Único tipo público de engine.
  Não depende das interfaces vazias da Trilha D.
end note

note right of RegraDeVitoriaStrategy
  Contratos preservados vazios.
  Strategy de regras ainda não está implementada.
end note

note bottom of PartidaListener
  Observer pendente: EventoDePartida e callbacks
  ainda não existem na main.
end note

note bottom of core
  Pacote transitório preservado porque seus tipos
  pertencem a outras trilhas. A Trilha A não o importa.
end note

legend left
  Azul: API pública
  Amarelo: runtime da Trilha A
  Cinza: artefatos transitórios de outras trilhas
endlegend

@enduml
