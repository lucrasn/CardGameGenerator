@startuml
title CardGame Framework — diagrama simplificado da main (15/08/2026)

' Smetana é o motor de layout Java embutido no próprio plantuml.jar: renderiza sem exigir
' Graphviz instalado. Não trocar por "elk": o Eclipse Layout Kernel vem em jars separados
' (licença EPL) e falta no plugin do IDE, o que resulta em ClassNotFoundException.
!pragma layout smetana
top to bottom direction

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
hide empty fields

package "br.edu.uepb.map.cardgame.api" as api #EAF2F8 {
    interface Carta <<public>> {
        +id(): UUID
    }

    interface "Baralho<C extends Carta>" as Baralho <<public>> {
        +quantidade(): int
        +estaVazio(): boolean
        +topo(): Optional<C>
        +comprar(): C
        +colocarNoTopo(carta: C): void
        +colocarNaBase(carta: C): void
        +embaralhar(): void
        +embaralhar(gerador: RandomGenerator): void
        +cartas(): List<C>
    }

    class "BaralhoPadrao<C>" as BaralhoPadrao <<public, final>>

    interface "BaralhoFactory<C>" as BaralhoFactory <<public, Factory Method>> {
        +criar(): Baralho<C>
    }

    interface "MaoDeCartas<C>" as MaoDeCartas <<public>> {
        +quantidade(): int
        +estaVazia(): boolean
        +adicionar(carta: C): void
        +buscar(id: UUID): Optional<C>
        +contem(id: UUID): boolean
        +remover(id: UUID): C
        +cartas(): List<C>
    }

    class "MaoDeCartasPadrao<C>" as MaoDeCartasPadrao <<public, final>>

    interface "ContextoDeDistribuicao<C>" as ContextoDeDistribuicao <<public>> {
        +jogadores(): List<Jogador>
        +cartasDisponiveis(): int
        +entregarProximaCarta(jogador: Jogador): void
    }

    interface "EstrategiaDeDistribuicao<C>" as EstrategiaDeDistribuicao <<public, Strategy>> {
        +distribuir(contexto: ContextoDeDistribuicao<C>): void
    }

    class "DistribuicaoAlternada<C>" as DistribuicaoAlternada <<public, final>>

    interface Jogador <<public>> {
        +id(): UUID
        +nome(): String
        +estrategiaDeDecisao(): EstrategiaDeDecisao
    }

    class JogadorPadrao <<public, final>> {
        +JogadorPadrao(nome: String, estrategia: EstrategiaDeDecisao)
        +alterarEstrategiaDeDecisao(novaEstrategia: EstrategiaDeDecisao): void
    }

    interface EstrategiaDeDecisao <<public, Strategy>> {
        +decidir(contexto: ContextoDeDecisao): Jogada
    }

    interface ContextoDeDecisao <<public, read-only>> {
        +etapa(): EtapaDeTurno
        +jogadasPermitidas(): List<Jogada>
    }
    interface EtapaDeTurno <<public, extensão>>
    interface Jogada <<public>>

    interface EntradaSaida <<public>> {
        +exibir(mensagem: String): void
        +solicitarOpcao(mensagem: String, opcoes: List<String>): int
    }

    class "estrategia.DecisaoAleatoria" as DecisaoAleatoria <<public, final>>
    class "estrategia.DecisaoGulosa" as DecisaoGulosa <<public, final>>
    class "estrategia.DecisaoHumanaConsole" as DecisaoHumanaConsole <<public, final>>
    class "io.ControleEntradaSaida" as ControleEntradaSaida <<public, final>>

    enum EstadoPartida <<public>> {
        CONFIGURADA
        PREPARANDO
        EM_ANDAMENTO
        FINALIZADA
        +podeTransitarPara(destino: EstadoPartida): boolean
        +ehTerminal(): boolean
        +destinosLegais(): Set<EstadoPartida>
    }

    interface "VisaoDaPartida<C>" as VisaoDaPartida <<public, read-only>> {
        +estado(): EstadoPartida
        +jogadores(): List<Jogador>
        +jogadorAtual(): Jogador
        +maoDe(jogador: Jogador): List<C>
        +quantidadeNoBaralho(): int
        +numeroDoTurno(): long
    }

    interface "ContextoDePartida<C>" as ContextoDePartida <<public>> {
        +comprarDoBaralho(): C
        +adicionarNaMao(jogador: Jogador, carta: C): void
        +removerDaMao(jogador: Jogador, cartaId: UUID): C
        +adicionarAoBaralho(cartas: Collection<? extends C>): void
        +embaralharBaralho(): void
    }

    class "PartidaConfig<C>" as PartidaConfig <<public, final, immutable>> {
        {static} +builder(): Builder<C>
        +jogadores(): List<Jogador>
        +baralhoFactory(): BaralhoFactory<C>
        +distribuicao(): EstrategiaDeDistribuicao<C>
        +primeiroJogador(): int
    }

    class "PartidaConfig.Builder<C>" as PartidaConfigBuilder <<public, final>> {
        +jogadores(jogadores: List<Jogador>): Builder<C>
        +baralhoFactory(baralhoFactory: BaralhoFactory<C>): Builder<C>
        +distribuicao(distribuicao: EstrategiaDeDistribuicao<C>): Builder<C>
        +primeiroJogador(primeiroJogador: int): Builder<C>
        +build(): PartidaConfig<C>
    }

    class ResultadoDoTurno <<public, record>> {
        +repetirJogador(): boolean
        +inverterSentido(): boolean
        +jogadoresAPular(): int
        {static} +avancar(): ResultadoDoTurno
        {static} +repetir(): ResultadoDoTurno
        {static} +inverter(): ResultadoDoTurno
        {static} +pular(quantidade: int): ResultadoDoTurno
    }

    interface MotivoDeEncerramento <<public, extensão>> {
        +ehVitoria(): boolean
        +ehEmpate(): boolean
    }

    enum MotivoPadrao <<public>> {
        VITORIA
        EMPATE
        ESGOTAMENTO
        ABANDONO
    }
    class DesfechoDePartida <<public, record, immutable>> {
        +vencedores(): List<Jogador>
        +motivo(): MotivoDeEncerramento
    }
    class ResultadoDePartida <<public, record, immutable>> {
        +vencedores(): List<Jogador>
        +placar(): Map<Jogador, Integer>
        +motivo(): MotivoDeEncerramento
        +houveEmpate(): boolean
        +vencedorUnico(): Optional<Jogador>
        +pontuacaoDe(jogador: Jogador): Optional<Integer>
    }

    interface RegraDeValidacaoStrategy <<public, placeholder vazio>>
    interface RegraDeVitoriaStrategy <<public, placeholder vazio>>
    interface RegraDePontuacaoStrategy <<public, placeholder vazio>>
    interface PartidaListener <<public, placeholder vazio>>

    abstract class PartidaException <<public>>
    class BaralhoVazioException <<public, final>>
    class JogadaInvalidaException <<public, final>>
    class EstadoDePartidaInvalidoException <<public, final>>
}

package "br.edu.uepb.map.cardgame.engine" as engine #FCF3CF {
    abstract class "MotorDePartida<C extends Carta>" as MotorDePartida <<public, Template Method>> {
        +executar(): ResultadoDePartida {final}
        +estado(): EstadoPartida {final}
        #preparar(contexto: ContextoDePartida<C>): void
        #aposDistribuir(contexto: ContextoDePartida<C>): void
        #executarTurno(contexto: ContextoDePartida<C>): ResultadoDoTurno {abstract}
        #avaliarDesfecho(contexto: VisaoDaPartida<C>): Optional<DesfechoDePartida> {abstract}
        #calcularPontuacao(contexto: VisaoDaPartida<C>, desfecho: DesfechoDePartida): Map<Jogador, Integer>
        #aoEncerrar(contexto: VisaoDaPartida<C>, resultado: ResultadoDePartida): void
    }

    class "PartidaEmExecucao<C>" as PartidaEmExecucao <<package-private, final>>
    class GerenciadorDeTurnos <<package-private, final>>
    enum SentidoDeRotacao <<package-private>>
    class CicloDeVidaDaPartida <<package-private, final>>
    class "ContextoDeDistribuicaoInterno<C>" as ContextoDeDistribuicaoInterno <<package-private, final>>
}

package "br.edu.uepb.map.cardgame.core" as core #F2F3F4 {
    class "ContextoDeDistribuicaoPadrao<C>" as ContextoDeDistribuicaoPadrao <<package-private, final, outra trilha>>
    class "estrategia.ContextoDeDecisaoPadrao" as ContextoDeDecisaoPadrao <<public, final, record, outra trilha>>
    class BaralhoBase <<public, placeholder legado>>
    class "MaoDeCartas" as MaoDeCartasLegada <<public, placeholder legado>>
    class Mesa <<public, placeholder legado>>
}

BaralhoPadrao ..|> Baralho
BaralhoFactory ..> Baralho : cria
MaoDeCartasPadrao ..|> MaoDeCartas
DistribuicaoAlternada ..|> EstrategiaDeDistribuicao
EstrategiaDeDistribuicao ..> ContextoDeDistribuicao : usa
JogadorPadrao ..|> Jogador
JogadorPadrao "0..*" o-- "1" EstrategiaDeDecisao
EstrategiaDeDecisao ..> ContextoDeDecisao
EstrategiaDeDecisao ..> Jogada
ContextoDeDecisao ..> EtapaDeTurno
ContextoDeDecisao --> "0..*" Jogada : permitidas
DecisaoAleatoria ..|> EstrategiaDeDecisao
DecisaoGulosa ..|> EstrategiaDeDecisao
DecisaoHumanaConsole ..|> EstrategiaDeDecisao
DecisaoHumanaConsole --> "1" EntradaSaida
ControleEntradaSaida ..|> EntradaSaida

ContextoDePartida --|> VisaoDaPartida
MotivoPadrao ..|> MotivoDeEncerramento
DesfechoDePartida --> "0..*" Jogador : vencedores
DesfechoDePartida --> "1" MotivoDeEncerramento
ResultadoDePartida --> "0..*" Jogador : vencedores
ResultadoDePartida --> "0..*" Jogador : chaves do placar
ResultadoDePartida --> "1" MotivoDeEncerramento

PartidaConfig "0..*" o-- "2..*" Jogador
PartidaConfig --> "1" BaralhoFactory
PartidaConfig --> "1" EstrategiaDeDistribuicao
PartidaConfig ..> PartidaConfigBuilder : builder()
PartidaConfigBuilder ..> PartidaConfig : cria

MotorDePartida --> "1" PartidaConfig
MotorDePartida "1" *-- "1" CicloDeVidaDaPartida
MotorDePartida ..> PartidaEmExecucao : cria por executar()
MotorDePartida ..> ContextoDeDistribuicaoInterno : cria para distribuir
MotorDePartida ..> ResultadoDoTurno : aplica
MotorDePartida ..> DesfechoDePartida : valida
MotorDePartida ..> ResultadoDePartida : cria

PartidaEmExecucao ..|> ContextoDePartida
PartidaEmExecucao "1" *-- "1" Baralho : exclusivo da execução
PartidaEmExecucao "1" *-- "2..*" MaoDeCartas : uma por jogador
PartidaEmExecucao ..> MaoDeCartasPadrao : cria
PartidaEmExecucao "1" *-- "1" GerenciadorDeTurnos
PartidaEmExecucao --> "1" CicloDeVidaDaPartida : consulta
GerenciadorDeTurnos --> "2..*" Jogador
GerenciadorDeTurnos --> "1" SentidoDeRotacao
ContextoDeDistribuicaoInterno ..|> ContextoDeDistribuicao
ContextoDeDistribuicaoInterno --> "1" PartidaEmExecucao

ContextoDeDistribuicaoPadrao ..|> ContextoDeDistribuicao
ContextoDeDistribuicaoPadrao --> "1" Baralho
ContextoDeDistribuicaoPadrao --> "0..*" Jogador
ContextoDeDistribuicaoPadrao --> "0..*" MaoDeCartas
ContextoDeDecisaoPadrao ..|> ContextoDeDecisao
ContextoDeDecisaoPadrao --> "1" EtapaDeTurno
ContextoDeDecisaoPadrao --> "0..*" Jogada

BaralhoVazioException --|> PartidaException
JogadaInvalidaException --|> PartidaException
EstadoDePartidaInvalidoException --|> PartidaException

note right of MotorDePartida
  Único tipo público de engine.
  Não depende das interfaces vazias da Trilha D.
end note

note top of api
  Diagrama simplificado: mostra contratos centrais,
  assinaturas relevantes e relações arquiteturais;
  não enumera todos os construtores e overloads.
  Nos tipos genéricos, C sempre estende Carta.
end note

note right of RegraDeVitoriaStrategy
  Contratos preservados vazios.
  Strategy de regras ainda não está implementada.
end note

note bottom of PartidaListener
  Observer pendente: EventoDePartida e callbacks
  ainda não existem na main.
end note

note bottom of core
  Pacote transitório preservado porque seus tipos
  pertencem a outras trilhas. A Trilha A não o importa.
end note

legend left
  Azul: API pública
  Amarelo: runtime da Trilha A
  Cinza: artefatos transitórios de outras trilhas
endlegend

@enduml
